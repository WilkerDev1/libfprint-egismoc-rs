# Maintainer: WilkerDev1 <capellancoronadowilker@gmail.com>
# Contributor: TenSeventy7
# Contributor: Joshua Grisham <josh@joshuagrisham.com>

pkgname=libfprint-egismoc-rs-git
pkgver=r1831.4d128d4
pkgrel=1
pkgdesc="Library for fingerprint readers with Rust Sans-I/O SDCP driver for EgisTec egismoc sensors (1c7a:0582 - 1c7a:05a5)"
url="https://github.com/WilkerDev1/libfprint-egismoc-rs"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  gcc-libs
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  cargo
  git
  glib2-devel
  gobject-introspection
  meson
)
checkdepends=(
  cairo
  umockdev
)
provides=(libfprint libfprint-2.so)
conflicts=(libfprint libfprint-egismoc-sdcp-git)
replaces=(libfprint-egismoc-sdcp-git)
groups=(fprint)
source=(
  "libfprint-egismoc-rs::git+https://github.com/WilkerDev1/libfprint-egismoc-rs.git"
  "libfprint-egismoc-sdcp::git+https://github.com/TenSeventy7/libfprint-egismoc-sdcp.git"
)
sha256sums=(
  'SKIP'
  'SKIP'
)

pkgver() {
  cd "${srcdir}/libfprint-egismoc-sdcp"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "${srcdir}/libfprint-egismoc-sdcp"
  patch -Np1 -i "${srcdir}/libfprint-egismoc-rs/patches/meson-egismoc-rs.patch"
}

build() {
  cd "${srcdir}/libfprint-egismoc-rs/egismoc-core"
  cargo build --release --locked

  cp -f "${srcdir}/libfprint-egismoc-rs/c-bridge/egismoc.c" \
        "${srcdir}/libfprint-egismoc-rs/c-bridge/egismoc.h" \
        "${srcdir}/libfprint-egismoc-rs/egismoc-core/include/egismoc_rs.h" \
        "${srcdir}/libfprint-egismoc-sdcp/libfprint/drivers/egismoc/"

  mkdir -p "${srcdir}/egismoc-core/target/release"
  cp -f "${srcdir}/libfprint-egismoc-rs/egismoc-core/target/release/libegismoc_core.a" \
        "${srcdir}/egismoc-core/target/release/libegismoc_core.a"

  cd "${srcdir}"
  local meson_options=(
    -D drivers=egismoc
    -D doc=false
    -D gtk-examples=false
    -D installed-tests=false
  )
  arch-meson libfprint-egismoc-sdcp build "${meson_options[@]}"
  meson compile -C build
}

check() {
  (cd "${srcdir}/libfprint-egismoc-rs/egismoc-core" && cargo test --locked)
  meson test -C "${srcdir}/build" --print-errorlogs
}

package() {
  meson install -C "${srcdir}/build" --destdir "${pkgdir}"
}
